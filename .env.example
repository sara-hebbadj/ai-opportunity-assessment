# Copy to "Portfolio Projects/.env" (two folders up) or to a local .env in this repo.
# Names only: never commit real values.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Bulk runs (theme coding, pre-check) and the live pre-check in the dashboard
MODEL_CHEAP=
# Second coder / scorer / checker
MODEL_MAIN=
# A third model from a different family (used as an extra independent scorer)
MODEL_JUDGE=

# Optional
# Budget guard for one evals.run command (US$); the run stops cleanly when it is reached
MAX_COST_PER_RUN_USD=2
# Hidden "reasoning" effort asked from every model call: low (default), medium, high, or "default" to send nothing
REASONING_EFFORT=
# Where model-call traces go (default: evals/results/traces.jsonl, or evals/dry_run/ for --dry-run)
TRACES_PATH=
